		"tsrs": "0.22.0-ts7.1.0-beta",
		"typescript": "^6.0.2",
		"vite-plus": "1.5.0",
		"vitest": "5.1.0"
	},
	"overrides": {
		"@effect/platform-node-shared": "4.1.2"
	}
}
