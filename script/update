#!/usr/bin/env bash
# Fast-forward pull every clone under repos/.
set -uo pipefail
source "$(dirname "$0")/lib.sh"

fail=0
while IFS=$'\t' read -r name url; do
	dir="$REPOS_DIR/$name"
	[ -e "$dir/.git" ] || continue
	if out=$(git -C "$dir" pull --ff-only 2>&1); then
		printf 'ok      %-22s %s\n' "$name" "$(printf '%s' "$out" | tail -1)"
	else
		printf 'FAIL    %-22s %s\n' "$name" "$out"
		fail=1
	fi
done < <(list_repos)

exit "$fail"
