#!/usr/bin/env bash
# Clone every non-archived ktbhealth org repo that isn't already under repos/.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

mkdir -p "$REPOS_DIR"

cloned=0
skipped=0
while IFS=$'\t' read -r name url; do
	dest="$REPOS_DIR/$name"
	if [ -e "$dest/.git" ]; then
		printf 'skip    %s (already cloned)\n' "$name"
		skipped=$((skipped + 1))
	elif [ -e "$dest" ]; then
		printf 'warn    %s exists but is not a git repo — leaving it alone\n' "$name" >&2
	else
		git clone "$url" "$dest" >/dev/null
		printf 'cloned  %s\n' "$name"
		cloned=$((cloned + 1))
	fi
done < <(list_repos)

printf 'done: %d cloned, %d already present\n' "$cloned" "$skipped"

"$ROOT/script/workspace" >/dev/null
